# ─────────────────────────────────────────────────────────────────────────────
# Copiá esto a `.env.local` (desarrollo) o a las variables del proveedor
# (Vercel → Settings / Environment Variables, Coolify → Environment).
# NINGÚN secreto va al repo: este archivo solo documenta los nombres.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública del sitio. Define canonical, OG, sitemap y robots.
# Sin esto, los links sociales salen con el dominio de ejemplo y Google ve
# un dominio que no existe.
NEXT_PUBLIC_SITE_URL=https://tartarugapuntacolorada.com

# WhatsApp de reserva. Gana el env sobre `content/site.json`, así se corrige el
# número sin tocar contenido (útil si el local cambia de línea).
# Formato E.164 sin `+`, espacios ni guiones.
NEXT_PUBLIC_WHATSAPP_PHONE=59844321831
# Alternativa: el link corto del perfil (wa.me/message/XXXX). Si está, se usa
# este y se ignora el número.
NEXT_PUBLIC_WHATSAPP_LINK=

# Webhook opcional para recibir las reservas del formulario (Slack, Make, n8n,
# un script propio). Si está vacío, el sitio igual funciona: el canal real es
# WhatsApp y `/api/booking` responde OK sin reenviar.
BOOKING_WEBHOOK_URL=
