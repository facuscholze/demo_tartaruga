{
  "name": "tartaruga-sea-bar",
  "version": "0.1.0",
  "private": true,
  "description": "Demo del sitio de Tartaruga Sea-Bar — Faro de Punta Colorada, Maldonado, Uruguay",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm content:check && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content:check": "tsx scripts/content-check.ts",
    "content:optimize": "tsx scripts/optimize-images.ts",
    "content:sync-images": "tsx scripts/sync-images.ts",
    "add:dish": "tsx scripts/add-dish.ts",
    "add:photo": "tsx scripts/add-photo.ts",
    "add:promo": "tsx scripts/add-promo.ts",
    "analyze": "ANALYZE=true next build",
    "verify": "pnpm lint && pnpm typecheck && pnpm content:check && pnpm test && pnpm build",
    "content:placeholders": "tsx scripts/generate-placeholders.ts",
    "prebuild": "tsx scripts/optimize-images.ts && tsx scripts/content-check.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.2.8",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "detect-gpu": "5.0.70",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "motion": "14.6.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "suncalc": "2.1.1",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
